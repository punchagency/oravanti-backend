# Supabase Storage API settings.
# Storage is used by profile avatar uploads and document uploads/downloads.

# JWT API keys generated from AUTH_JWT_SECRET.
# The app's SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY must match these values.
ANON_KEY=replace-with-local-anon-jwt
SERVICE_KEY=replace-with-local-service-role-jwt

# JWT secrets. Keep these aligned with .env.auth and .env.rest.
AUTH_JWT_SECRET=replace-with-your-local-jwt-secret
PGRST_JWT_SECRET=replace-with-your-local-jwt-secret

# Storage metadata database and PostgREST endpoint.
# The supabase_storage_admin role is created in docker/supabase/init/00-roles.sql.
DATABASE_URL=postgres://supabase_storage_admin:postgres@db:5432/postgres
POSTGREST_URL=http://rest:3000

# File-backed local storage settings.
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
STORAGE_PUBLIC_URL=http://localhost:54321/storage/v1
REQUEST_ALLOW_X_FORWARDED_PATH=true
FILE_SIZE_LIMIT=52428800
GLOBAL_S3_BUCKET=local
TENANT_ID=local
REGION=local

# Image transformations are disabled, so no imgproxy service is needed.
ENABLE_IMAGE_TRANSFORMATION=false
