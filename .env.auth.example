# Supabase Auth (GoTrue) settings.

# GoTrue listens on this internal container address.
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999

# Public auth URL exposed through Kong.
API_EXTERNAL_URL=http://localhost:54321/auth/v1

# Frontend URL and allowed redirect origins.
GOTRUE_SITE_URL=http://localhost:5173
GOTRUE_URI_ALLOW_LIST=http://localhost:5173,http://localhost:3000,http://localhost:54321

# Auth database connection.
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgres://postgres:postgres@db:5432/postgres
GOTRUE_DB_MIGRATIONS_AUTO_RUN=true

# Local auth behavior.
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
GOTRUE_MAILER_AUTOCONFIRM=true

# JWT settings. Use the same secret in .env.rest and .env.storage.
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_SECRET=replace-with-your-local-jwt-secret
