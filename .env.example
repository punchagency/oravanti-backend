# ============================================================================
# This is an example env file for your reference.
# 1. Copy this file: cp .env.example .env
# 2. Fill in all the values based on your setup
# 3. Keep sensitive values like API keys and passwords secure
# ============================================================================

# ============================================================================
# APP CONFIG - Basic application settings
# ============================================================================

# Port on which the Express server will run
# Type: number
# Example: 3000, 5000, 8000
PORT=3000

# CORS (Cross-Origin Resource Sharing) origin(s) allowed to access this API
# Type: string (comma-separated for multiple origins)
# Examples:
#   - Single origin: http://localhost:5173
#   - Multiple origins: http://localhost:5173,https://app.example.com
#   - All origins (NOT recommended for production): *
CORS_ORIGIN=http://localhost:5173

# Base URL of the application (used for redirects, links in emails, etc.)
# Type: string (absolute URL)
# Examples:
#   - Development: http://localhost:3000
#   - Production: https://api.oravanti.com
APP_URL=http://localhost:3000

# ============================================================================
# DATABASE CONFIG - PostgreSQL database connection settings
# ============================================================================

# PostgreSQL connection string (combines host, port, username, password, database)
# Type: string (PostgreSQL connection URL)
# Format: postgresql://username:password@host:port/database_name
# Examples:
#   - Docker Compose API container: postgresql://postgres:password123@db:5432/postgres
#   - Host machine: postgresql://postgres:password123@localhost:5432/postgres
# Read more: https://www.postgresql.org/docs/current/libpq-connstring.html
DATABASE_URL=postgresql://postgres:password123@db:5432/postgres

# Production/runtime database connection string.
# The Dockerfile sets NODE_ENV=production, so the API reads PROD_DATABASE_URL in the production image.
PROD_DATABASE_URL=postgresql://postgres:password123@db:5432/postgres

# The database `npm run check <name>` and `npm run test:db:setup` use. It must
# resolve to a DIFFERENT database from DATABASE_URL — the setup script refuses
# to run otherwise, because it drops and recreates what it points at.
TEST_DATABASE_URL=postgresql://postgres:password123@localhost:5432/postgres_test

# Alternative to the line above: give only the database NAME and it is swapped
# into DATABASE_URL, keeping the same host, port and credentials. Ignored when
# TEST_DATABASE_URL is set.
# Type: string   Default: unset
# TEST_DATABASE_NAME=oravanti_test

# ── Database security baseline ───────────────────────────────────────────────
# Applied by `npm run security:baseline`, which creates two roles that Drizzle
# migrations cannot: roles, grants and FORCE ROW LEVEL SECURITY are not schema.
#
# These two passwords are read ONLY when the roles are first created. A re-run
# without them leaves existing passwords untouched, so they do not need to stay
# in the environment afterwards.
ORAVANTI_APP_DB_PASSWORD=
ORAVANTI_MAINTENANCE_DB_PASSWORD=

# The audit retention job's own connection, using the `oravanti_maintenance`
# role. It is separate from DATABASE_URL on purpose: `oravanti_app` is denied
# DELETE on audit_events by the baseline (plan-02 step 35), which is what makes
# the trail append-only, so the purge job cannot and must not share it.
#
# Leave empty to disable retention entirely. The job refuses to fall back to the
# application connection — running with the wrong privileges would work today
# and hide the fact that the immutability grant was never applied.
# Example: postgresql://oravanti_maintenance:<password>@db:5432/postgres
MAINTENANCE_DATABASE_URL=


# PostgreSQL database user password.
# ⚠️ NOT READ BY ANY CODE. The password is taken from DATABASE_URL; nothing
# falls back to this. Kept only because deployment tooling may still set it.
# Type: string
DATABASE_PASSWORD=password123

# The role `npm run db:reset` re-grants the public schema to after dropping it.
# This is the OWNER role — see docs/database-security.md §3.1. Defaults to
# "postgres" when unset, which is wrong if your owner is oravanti_admin.
# Type: string   Default: postgres
DATABASE_USER=postgres

# ============================================================================
# CLOUDFLARE R2 CONFIG - S3-compatible object storage for file uploads
# Reference: https://developers.cloudflare.com/r2/api/s3/api/
# ============================================================================

# Cloudflare account ID. Found in the Cloudflare dashboard URL or R2 overview page.
# The S3 endpoint is derived from this: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Type: string
R2_ACCOUNT_ID=replace-with-cloudflare-account-id

# R2 API token credentials (PRIVATE - server-side only).
# Create under R2 > Manage R2 API Tokens > Create API Token (Object Read & Write).
# Type: string (secret)
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Name of the R2 bucket that holds all uploaded files (documents, questionnaire
# response files, contractor docs, avatars — separated by key prefixes).
# Type: string
R2_BUCKET=replace-with-r2-bucket-name

# ============================================================================
# BETTER_AUTH CONFIG - Authentication & Authorization Framework
# Reference: https://better-auth.com/docs
# ============================================================================

# Better Auth secret key used to sign and verify tokens/session cookies
# Type: string (random, cryptographically secure)
# How to generate: openssl rand -base64 32 || use `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# Example output: oZnhVUQfpUJvL6X8YzP2k0=
# This should be different per environment (dev, staging, production)
BETTER_AUTH_SECRET=oZnhVUQfpUJvL6X8YzP2k0m9nL4jHgF=

# Better Auth base URL (must match CORS_ORIGIN and APP_URL)
# Type: string (absolute URL)
# This tells Better Auth where the app is running from
# Examples:
#   - Development: http://localhost:3000
#   - Production: https://api.oravanti.com
BETTER_AUTH_URL=http://localhost:3000

# Better Auth API Key (Better Auth's managed SaaS) - optional
# ⚠️ NOT READ BY ANY CODE. This deployment is self-hosted Better Auth, so
# nothing consults it. Left here for the day the managed service is used.
# Type: string
BETTER_AUTH_API_KEY=

# Node.js runtime environment
# Type: string (enum: development, staging, production, test)
# Effects: logging verbosity, error handling, performance optimizations
# Examples:
#   - development: verbose logging, hot reloading enabled
#   - production: minimal logging, optimizations enabled, strict error handling
NODE_ENV=development

# ============================================================================
# EMAIL SMTP CONFIG - Outbound email via Gmail or other SMTP providers
# Reference: https://nodemailer.com/smtp/
# ============================================================================

# SMTP server email address (sender email)
# Type: string (valid email address)
# For Gmail: use your Gmail address or App Password
# Example: noreply@oravanti.com or your-email@gmail.com
SMTP_EMAIL_ADDRESS=noreply@oravanti.com

# SMTP server password (authentication for sending emails)
# Type: string
# For Gmail:
#   1. Enable 2-Step Verification on your Google account
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character password generated
# For other providers: use your email account password or application-specific password
# Example Gmail App Password: aabbccdd eeffgghh iijjkkll mmnnoopp (16 chars, no spaces)
# ⚠️ CRITICAL: Keep this secret - never commit to version control
SMTP_PASSWORD=aabbccddee_ffgghh_iijjkkll_mmnnoopp

# Resend, an alternative transactional email provider (src/utils/email/
# resend.email-service.ts). Optional: SMTP above is the default path, and
# ResendEmailService throws if it is constructed without this key.
# Type: string (secret, optional)
# Example: re_aabbccdd_EeFfGgHhIiJjKkLlMmNnOoPp
RESEND_API_KEY=

# ============================================================================
# CRYPTO KEY CONFIG - Master key for encryption/decryption of user DEKs
# ============================================================================

# Primary master key used to encrypt/decrypt per-user Data Encryption Keys (DEKs).
# Type: string (64 hex chars = 32 bytes — aes-256-gcm takes a 32-byte key and throws "Invalid key length" on anything else)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example: aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899...
# ⚠️ CRITICAL: Keep this secret. Rotate carefully as all DEKs are encrypted with it.
SERVER_MASTER_KEY_PRIMARY=

# Previous/old master key used during key rotation to decrypt DEKs that were
# encrypted with the old key. Set this when rotating SERVER_MASTER_KEY_PRIMARY.
# Type: string (64 hex chars = 32 bytes — aes-256-gcm takes a 32-byte key and throws "Invalid key length" on anything else)
# Leave empty if no rotation has occurred.
SERVER_MASTER_KEY_OLD=

# ============================================================================
# OAUTH PROVIDERS - Google & Microsoft OAuth credentials
# ============================================================================

# Google OAuth Client ID (used for Gmail email account linking)
# Type: string
# From: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Reference: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret (keep secure, server-side only)
# Type: string (secret)
# From: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# ⚠️ CRITICAL: Never expose this in client-side code or version control
GOOGLE_CLIENT_SECRET=

# --- Platform Google Meet (centralized, optional) ---
# Service account used to mint Google Meet links for ALL firms. When unset, the
# Meet service falls back to a placeholder link (fine for local/dev without a
# Workspace seat). Requires domain-wide delegation + a Google Workspace user to
# impersonate. Scope: https://www.googleapis.com/auth/calendar.events
# Service account client email (e.g. meet-bot@project.iam.gserviceaccount.com)
GOOGLE_MEET_CLIENT_EMAIL=
# Service account private key (PEM; escape newlines as \n in a single line)
GOOGLE_MEET_PRIVATE_KEY=
# Workspace user the service account impersonates (the meeting organizer)
GOOGLE_MEET_IMPERSONATED_USER=

# Microsoft Entra ID (Azure AD) Application (client) ID
# Type: string (UUID)
# From: Azure Portal > App Registrations > Your App > Overview > Application (client) ID
# Reference: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=

# Microsoft Entra ID Client Secret (keep secure, server-side only)
# Type: string (secret)
# From: Azure Portal > App Registrations > Your App > Certificates & Secrets > Client Secrets
# ⚠️ CRITICAL: Never expose this in client-side code or version control
MICROSOFT_CLIENT_SECRET=

# ============================================================================
# ENCRYPTION KEYS - For credential and payment data encryption
# ============================================================================

# Key used to encrypt/decrypt email credentials (SMTP passwords, etc.)
# Type: string (64 hex chars = 32 bytes for AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ CRITICAL: Keep this secret. Rotating it will invalidate stored credentials.
EMAIL_ENCRYPTION_KEY=

# Key used to encrypt/decrypt payment-related data
# Type: string (any length, hashed to 256-bit via SHA-256)
# ⚠️ CRITICAL: Keep this secret.
PAYMENT_ENCRYPTION_KEY=

# Fallback/legacy payment encryption key (used during key rotation)
# Leave empty if no rotation has occurred.
# Type: string (same format as PAYMENT_ENCRYPTION_KEY)
CONTRACTOR_PAYMENT_ENCRYPTION_KEY=

# ============================================================================
# EMAIL VERIFICATION - Callback URLs for email verification flows
# ============================================================================

# Frontend URL that users are redirected to after email verification
# Type: string (absolute URL)
# Examples:
#   - Development: http://localhost:5173/login
#   - Production: https://app.oravanti.com/login
EMAIL_VERIFICATION_CALLBACK_URL=http://localhost:5173/login

# Base URL of the frontend app, used to build links in outbound email and
# redirects. Required by src/config/env.ts — the server refuses to start
# without it.
# Type: string (absolute URL, no trailing slash)
# Examples:
#   - Development: http://localhost:5173
#   - Production: https://app.oravanti.com
FRONTEND_APP_URL=http://localhost:5173

# ============================================================================
# REDIS - Connection URL for BullMQ queues & workers (reminders, document scans)
# ============================================================================

# Type: string (redis connection URL)
# Examples:
#   - Local:        redis://localhost:6379
#   - Docker compose: redis://redis:6379
REDIS_URL=redis://localhost:6379

DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_TEST_MODE=
# Dev-only: set to "true" to skip the fee-agreement "payment received"
# requirement on the case-opening gate. Ignored in production.
FEE_PAYMENT_GATE_BYPASS=

# ============================================================================
# EMAIL DELIVERY - Resend API key and delivery-tracking webhook
# =====================================================================
# Resend API key. Used by ResendEmailService, which is selected in production;
# development sends over Gmail SMTP via SMTP_EMAIL_ADDRESS / SMTP_PASSWORD.
# Type: string (re_...)
RESEND_API_KEY=

# Svix signing secret for Resend's delivery webhooks (POST /webhooks/resend).
# Required TOGETHER with RESEND_API_KEY: without it the endpoint cannot verify
# what it is sent, so it refuses everything and email notifications simply stop
# at "sent" instead of reaching "delivered".
#
# Resend signs the RAW request body, so this endpoint is mounted before the JSON
# body parser in src/app.ts. Leave unset in development — Gmail SMTP emits no
# delivery callbacks at all, so there is nothing to receive.
# Type: string (whsec_...)
RESEND_WEBHOOK_SECRET=

# ============================================================================
# SMS PROVIDER SELECTION
# ============================================================================

# Which vendor sends text messages: "twilio" or "telnyx" (case-insensitive).
#
# Unset or unrecognised falls back to a stub that sends nothing and records
# every send as skipped/provider_unconfigured — a fully supported state, not a
# broken one. An unrecognised value logs a warning rather than failing silently.
#
# This is the rollback switch: a problem with one vendor is one env var and a
# restart. BOTH /webhooks/twilio and /webhooks/telnyx stay mounted whatever this
# says, so status callbacks for messages already in flight are still accepted
# during a switchover — a dropped callback can mean a lost opt-out.
SMS_PROVIDER=

# ============================================================================
# SMS (TELNYX) - Platform-owned account shared by every firm
# ============================================================================

# Only used when SMS_PROVIDER=telnyx.
# Type: string (KEY...)
TELNYX_API_KEY=

# Preferred sender. A Messaging Profile gives number pools and profile-level
# opt-out handling, the same role Twilio's Messaging Service plays.
# Type: string (UUID)
TELNYX_MESSAGING_PROFILE_ID=

# Single-number fallback, used when no Messaging Profile is set.
# Type: string (E.164, e.g. +14155552671)
TELNYX_FROM_NUMBER=

# Ed25519 PUBLIC key that verifies inbound webhooks. Mission Control Portal →
# Keys & Credentials → Public Key. Base64, raw 32 bytes.
#
# REQUIRED whenever Telnyx is active, and treated as such: without it the
# provider does not resolve at all. That is deliberate. Telnyx absorbs STOP at
# the messaging-profile level, so its blocked-recipient error is often the only
# opt-out signal we get — with a MISSING key nothing sends (safe), but with a
# WRONG one sends work perfectly while every opt-out is rejected as forged and
# the platform keeps texting people who said stop.
# Type: string (base64)
TELNYX_PUBLIC_KEY=

# The public base URL Telnyx should call back on, no trailing slash.
# Unlike Twilio, Telnyx does not sign the URL, so this need not be byte-exact —
# but without it no webhook_url is sent and rows stop at "sent".
# Type: string (absolute URL)
TELNYX_WEBHOOK_BASE_URL=

# ============================================================================
# SMS (TWILIO) - Platform-owned account shared by every firm
# ============================================================================

# Only used when SMS_PROVIDER=twilio.
#
# Unset by default. With no credentials the app falls back to a stub SMS
# provider that logs and sends nothing, which is a fully supported state — and
# consultation_settings.sms_enabled defaults to false on top of that, so no firm
# sends SMS until an admin turns it on.
#
# Account SID and auth token are required TOGETHER, plus one sender. The auth
# token also verifies the status and inbound webhooks.
# Type: string (AC...)
TWILIO_ACCOUNT_SID=
# Type: string
TWILIO_AUTH_TOKEN=

# Preferred sender. A Messaging Service gives sender pools, sticky sender and
# Advanced Opt-Out (carrier-level STOP handling). Takes precedence over
# TWILIO_FROM_NUMBER when both are set.
# Type: string (MG...)
TWILIO_MESSAGING_SERVICE_SID=

# Single-number fallback for local and trial use.
# Type: string (E.164, e.g. +14155552671)
TWILIO_FROM_NUMBER=

# The EXACT public base URL Twilio is configured to call, with no trailing
# slash — e.g. https://api.oravanti.com
#
# Twilio signs an HMAC over the request URL plus its sorted form parameters, so
# the URL must be reproduced byte for byte. Rebuilding it from req.protocol
# fails behind a proxy (the app sees "http" while Twilio signed "https") and
# rejects every legitimate request as forged.
# Type: string (absolute URL)
TWILIO_WEBHOOK_BASE_URL=

# Optional ISO-3166 region used to parse phone numbers written without a country
# code, e.g. "US". Left unset deliberately: an ambiguous number then fails
# loudly as unsendable rather than being silently attributed to the wrong
# country and delivered to a stranger.
# Type: string (2-letter country code)
PHONE_DEFAULT_REGION=

# NOTE: scheduled notifications (consultation reminders) are BullMQ delayed jobs,
# which live only in Redis. Run the Redis instance with `appendonly yes` so a
# restart does not silently drop every pending reminder. A 15-minute sweep
# re-enqueues anything lost, but persistence is the first line of defence.
=======
# CONFIDO LEGAL - Payment provider
# ============================================================================
# The payment processor, chosen over Stripe because it routes a single client
# payment into separate trust (IOLTA) and operating accounts.
#
# Per-firm API tokens are NOT configured here: each organization gets its own
# from Confido, stored encrypted in `confido_firms`.

# Required TOGETHER with CONFIDO_WEBHOOK_SECRET; with only one set the
# integration reports itself unconfigured and refuses rather than half-works.
# Both are environment-specific — a sandbox token is rejected in production and
# vice versa. Get them from the Partner Portal under Settings.
# Type: string (secret, optional)   Example: p_secret_sandbox_…
CONFIDO_PARTNER_TOKEN=

# Verifies inbound webhook signatures. See CONFIDO_PARTNER_TOKEN above.
# Type: string (secret, optional)
CONFIDO_WEBHOOK_SECRET=

# Type: string (optional)   Default: https://api.sandbox.gravity-legal.com/v2
# Production is https://api.gravity-legal.com/
CONFIDO_API_URL=

# The onboarding.js bundle the payment settings page embeds.
# Type: string (optional)   Sandbox: https://js.sandbox.gravity-legal.com/onboarding.js
CONFIDO_ONBOARDING_JS_URL=

# ============================================================================
# LOGGING - Structured application logs (src/lib/logging)
# ============================================================================
# All optional; the defaults below are what you get if the keys are absent.
# Read directly from process.env by src/lib/logging/config.ts, deliberately
# NOT through src/config/env.ts — the logger has to be constructible in a
# unit test or a script without a fully populated environment.

# Which driver backs the logger. Both are installed and the conformance
# suite proves they emit identical records, so this is genuinely reversible.
# An unrecognised value throws at startup rather than falling back.
# Type: "pino" | "winston"   Default: pino
LOG_DRIVER=pino

# Type: trace|debug|info|warn|error|fatal   Default: info
# An unrecognised value throws rather than silently falling back to info.
LOG_LEVEL=info

# How records are written. Rendering is shared by both drivers, so the format
# is independent of LOG_DRIVER.
#
#   json         One record per line. The only format a log shipper can parse,
#                and therefore the only one production may use.
#   pretty       Coloured one-line header plus aligned fields. Best for
#                watching a server run.
#   json-pretty  Indented JSON — the same record, laid out, and still valid
#                JSON if you select it out of the terminal and paste it
#                somewhere. Best for reading one request in full.
#
# Defaults to pretty locally and json under NODE_ENV=production or test.
# An unrecognised value throws at startup rather than falling back.
# Type: "json" | "pretty" | "json-pretty"   Default: pretty (json in prod/test)
LOG_FORMAT=json

# Deprecated boolean spelling of the above, still honoured so existing .env
# files keep working: true -> pretty, false -> json. LOG_FORMAT wins if both
# are set. Prefer LOG_FORMAT.
# Type: boolean   Default: unset
# LOG_PRETTY=

# Show every field in `pretty` output, including the ones that are identical
# on every line of the process (service, env, version, pid, trace_flags).
# They are hidden by default because pretty is the format meant to be skimmed.
# Both JSON formats always show everything and ignore this.
# Type: boolean   Default: false
# LOG_VERBOSE=false

# The level the "request received" line is logged at. Every request also logs
# a completion line, so the entry line doubles the volume for little gain once
# a service is stable: "debug" keeps it available without the cost, "off"
# removes it entirely. Worth setting to one of those in production.
# Type: "info" | "debug" | "off"   Default: info
# LOG_REQUEST_ENTRY=info

# Colour in `pretty` output. Both are conventions honoured by many CLI tools,
# not names invented here, and they are normally set per-invocation rather than
# in .env. NO_COLOR wins if both are set; otherwise colour follows whether
# stdout is a TTY.
# Type: any non-empty value disables / enables
# NO_COLOR=
# FORCE_COLOR=

# Winston only. Off everywhere by design: files are ephemeral in a container
# and an unbounded writer fills the volume. Logs belong on stdout.
# Type: boolean   Default: false
LOG_FILE_ENABLED=false

# Stamped onto every record as `version`, for correlating logs with a deploy.
# Type: string (optional)
APP_VERSION=

# ============================================================================
# OPENTELEMETRY - Traces, metrics and log export
# Reference: https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
# ============================================================================
#
# Everything here is off by default. Nothing starts a background exporter
# unless it has been asked to.
#
# The variable names are the OpenTelemetry specification's own, not names
# invented for this app, so any collector guide, Helm chart or runbook applies
# unchanged. The SDK reads several more of them directly — OTEL_SERVICE_NAME,
# OTEL_EXPORTER_OTLP_HEADERS, OTEL_EXPORTER_OTLP_PROTOCOL,
# OTEL_RESOURCE_ATTRIBUTES — and they all work without appearing here.
#
# Three configurations worth knowing:
#
#   1. Correlated logs, no infrastructure.       OTEL_ENABLED=true
#      Spans are created but never exported, so every log line gains trace_id
#      and span_id and every request's lines can be grouped. Costs nothing and
#      needs no collector. Start here.
#
#   2. Watch the pipeline work.                  OTEL_TRACES_EXPORTER=console
#      Dumps each span to stdout as it completes. A debugging tool, not a
#      deployment mode — it is verbose, it interleaves with the pretty log
#      output, and it is never appropriate in production.
#
#   3. Ship it.                                  OTEL_EXPORTER_OTLP_ENDPOINT=...
#      Sets every signal to otlp. The normal production configuration.

# Collector endpoint. Setting this switches traces, logs and metrics to otlp
# and is the only variable most deployments need.
# Type: string (absolute URL, optional)
# Example: http://localhost:4318   (an OTLP/HTTP collector)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Master switch. Defaults to on when anything above is configured, so it is
# only worth setting explicitly to force the SDK on with no exporter (see
# configuration 1) or off while leaving an endpoint in place.
# Type: boolean   Default: true when configured, false otherwise
# OTEL_ENABLED=

# The specification's kill switch. Overrides everything, including an endpoint
# — for silencing a service without redeploying it.
# Type: boolean   Default: false
# OTEL_SDK_DISABLED=false

# Per-signal destination, read and validated by the SDK itself — this app does
# not construct exporters. Default: otlp when an endpoint is set, none if not.
# Type: "otlp" | "console" | "none"   (metrics also accepts "prometheus")
# OTEL_TRACES_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
# OTEL_METRICS_EXPORTER=none

# Head sampling ratio: the fraction of traces recorded. 1 keeps every trace,
# which is right until volume says otherwise. Logs are never sampled.
# An unparseable value throws at startup — telemetry that looks configured and
# silently records nothing is the worse failure.
# Type: number 0..1   Default: 1
# OTEL_TRACES_SAMPLER_ARG=1

# The name this service reports itself as. Read by the SDK and by
# src/telemetry/config.ts, which supplies the default.
# Type: string   Default: oravanti-api
# OTEL_SERVICE_NAME=oravanti-api

# ============================================================================
# DEVELOPMENT CHECKS - Gates for `npm run check <name>` (scripts/checks/)
# ============================================================================
# Only ever set locally. Nothing in the application reads these.

# Permits the checks that hit real external services (live object storage, the
# live AI round-trip) instead of stubs. Equivalent to passing `-- --live`.
# Type: "1" to allow   Default: unset (those checks refuse to run)
# ORAVANTI_LIVE=

# Path to the sibling oravanti-AI repository, used by the round-trip checks to
# find the service and its sample documents.
# Type: string (absolute path)   Default: ../oravanti-AI relative to this repo
# ORAVANTI_AI=


