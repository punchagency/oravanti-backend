# PostgREST settings used by Supabase Storage for metadata access.

# Database connection string for the authenticator role created in docker/supabase/init/00-roles.sql.
PGRST_DB_URI=postgres://authenticator:postgres@db:5432/postgres

# Schemas exposed through PostgREST. Storage requires the storage schema.
PGRST_DB_SCHEMAS=public,storage

# Anonymous role used when requests are not authenticated.
PGRST_DB_ANON_ROLE=anon

# JWT settings. Use the same secret as GOTRUE_JWT_SECRET and AUTH_JWT_SECRET.
PGRST_JWT_SECRET=replace-with-your-local-jwt-secret
PGRST_DB_USE_LEGACY_GUCS=false
PGRST_APP_SETTINGS_JWT_SECRET=replace-with-your-local-jwt-secret
PGRST_APP_SETTINGS_JWT_EXP=3600
