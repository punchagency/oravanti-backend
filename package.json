    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:generate": "drizzle-kit generate",
