    "db:push": "drizzle-kit push",
    "db:setup": "tsx scripts/db-setup.ts",
    "auth:generate": "auth generate --output ./src/db/schema/auth-schema.ts --yes",
    "db:clear": "tsx src/db/clear-all.ts",
    "db:reset": "tsx src/db/reset.ts",
    "test:db:setup": "tsx scripts/test-db/setup.ts",
    "test:db:clear": "tsx scripts/test-db/drop.ts",
    "test:db:drop": "tsx scripts/test-db/drop.ts --database",
    "check": "tsx scripts/check.ts",
    "routes:audit": "tsx scripts/routes-audit.ts",
    "backfill:financial-access": "tsx scripts/backfill-financial-access.ts",
    "backfill:time-entry-status": "tsx src/scripts/backfill-time-entry-status.ts",
    "security:baseline": "tsx scripts/apply-security-baseline.ts",
    "audit:retention": "tsx scripts/run-audit-retention.ts",
    "prepare": "husky"
