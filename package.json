{
  "name": "oravanti-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch  .",
    "worker": "tsx src/queue/worker-entry.ts",
    "worker:dev": "tsx watch src/queue/worker-entry.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "practice-areas:admin": "tsx src/cli.ts",
