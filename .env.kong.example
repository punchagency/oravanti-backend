# Kong API gateway settings for local Supabase services.
# Kong routes /auth/v1, /rest/v1, and /storage/v1 to internal containers.

# Use declarative config instead of a Kong database.
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/usr/local/kong/declarative/kong.yml

# Docker DNS resolution behavior for upstream service names.
KONG_DNS_ORDER=LAST,A,CNAME

# Keep this aligned with the plugins used in docker/supabase/kong.yml.
KONG_PLUGINS=bundled

# Container log destinations.
KONG_PROXY_ACCESS_LOG=/dev/stdout
KONG_ADMIN_ACCESS_LOG=/dev/stdout
KONG_PROXY_ERROR_LOG=/dev/stderr
KONG_ADMIN_ERROR_LOG=/dev/stderr
